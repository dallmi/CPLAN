# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/

# Pipeline outputs (regenerated from input data)
pipeline/data/*.db
pipeline/output/*.parquet
pipeline/output/*.json
pipeline/output/*.html
pipeline/output/*.xlsx
pipeline/output/reports/
# The agent pack carries the same production figures as the workbook, in files
# that are meant to be uploaded rather than committed -- and checklist.md holds
# the answer key beside them.
pipeline/output/agent-pack/
# The same figures again, and the same answer key: this is where the Agent
# Builder delivery lands on a machine with no OneDrive.
pipeline/output/agent-builder/

# Pipeline docs (internal only)
pipeline/docs/

# Pipeline inputs (synced via OneDrive, not committed)
pipeline/input/*.csv

# Environment
.env*
!.env.example

# CPLAN local runtime state (user-owned, never committed)
/data/
/logs/
/backups/
cplan-settings.json
pipeline/data/cplan-settings.json
pipeline/data/cplan-settings.json.tmp
cplan.config
# The GEB membership list names real people. The .example beside it carries
# placeholders and is committed; these never are. Both formats are ignored
# because the report reads either -- ignoring only the one the loader used to
# accept would leave the other sitting in `git status` waiting to be added.
geb-members.csv
geb-members.xlsx
# Tracking-ID lists to check. They name campaigns and carry notes, and they are
# working files rather than repository content -- a list is something someone
# mailed you this morning. The two default names are ignored because the check
# reads either, and the folder alongside them so a list can be named for what
# it is a list of.
ids.txt
ids.xlsx
ids/
# The list of terms the pre-commit guard refuses. Ignored for the reason the
# terms exist: a committed list of words that must not appear in the repository
# would put every one of them in the repository. The .example beside it carries
# placeholders and is committed.
forbidden-terms.txt
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Embedded PostgreSQL data directory (default lives outside the repo, in the
# platform user-data dir -- ignored here only as a safety net for --pgdata
# pointed at a repo-relative path)
pipeline/data/postgres/
pgdata/

# Pictures
pictures/

# Browser-automation artifacts
.playwright-mcp/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Eval reports are run artefacts, not documentation.
evals/results/
evals/last-run.log

# Agent worktrees are checkouts of this same repository, created and removed by
# tooling. Committing one nests a working copy inside the working copy.
.claude/worktrees/

# Local working copies that are deliberately NOT organisation-neutral: agent
# instructions carrying the brand name and its palette, drafts pasted from an
# internal tool. Kept in the tree so they can be copied out of it, kept out of
# the history because a repository can become public and a commit cannot be
# unmade.
*.local.md
