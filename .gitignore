# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv/

# Pipeline outputs (regenerated from input data)
pipeline/data/*.db
pipeline/output/*.parquet
pipeline/output/*.json
pipeline/output/*.html

# Pipeline docs (internal only)
pipeline/docs/

# Pipeline inputs (synced via OneDrive, not committed)
pipeline/input/*.csv

# Environment
.env*
!.env.example

# CPLAN V6 local runtime state (user-owned, never committed)
/data/
/logs/
/backups/
cplan-settings.json
pipeline/data/cplan-settings.json
pipeline/data/cplan-settings.json.tmp
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Pictures
pictures/

# Browser-automation artifacts
.playwright-mcp/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
